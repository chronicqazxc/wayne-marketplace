{
  "name": "wordpress-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WordPress.com MCP server using the WordPress.com REST API",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "marked": "^18.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
