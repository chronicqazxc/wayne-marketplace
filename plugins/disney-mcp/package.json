{
  "name": "disney-mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted Disney+ availability MCP server using the official TMDB API (read-only)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/server.ts src/auth.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "auth": "node dist/auth.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
